{
  "name": "magma",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "all": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "design-tokens:build",
        "svg-icons:build",
        "identity:build",
        "codemod:build",
        "styles:build",
        "icons:build",
        "stencil:build",
        "stencil-react:build",
        "stencil-angular:build"
      ]
    },
    "check.diagrams": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["tsx --test scripts/diagrams.spec.ts", "tsx scripts/diagrams.ts"],
        "parallel": false
      }
    }
  }
}
