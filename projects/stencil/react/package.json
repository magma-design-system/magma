{
  "name": "@maggioli-design-system/magma-react",
  "version": "2.0.0-alpha.1",
  "main": "dist/components.js",
  "module": "dist/components.js",
  "types": "dist/types/components.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./*.js": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run tsc",
    "tsc": "tsc -p . --outDir ./dist"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "agents/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@maggioli-design-system/magma": "2.0.0-alpha.1",
    "@stencil/react-output-target": "1.6.2"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magma-design-system/magma.git",
    "directory": "projects/stencil/react"
  }
}
