{
  "name": "@maggioli-design-system/styles",
  "version": "17.2.1",
  "description": "This module contains SCSS and CSS styles used by Maggioli Design System, it also makes available a Tailwind config based on Maggioli design tokens.",
  "main": "./tailwind.config.js",
  "scripts": {
    "build": "npm run clean && npm run semantic && npm run corner && npm run properties && npm run editor.tokens && npm run copy && npm run hydrated && npm run dtcg && npm run consumption && npm run tailwind.build",
    "clean": "tsx scripts/clean.ts",
    "semantic": "tsx scripts/semantic.ts",
    "properties": "tsx scripts/properties.ts",
    "corner": "tsx scripts/corner.ts",
    "editor.tokens": "tsx scripts/editor-tokens.ts",
    "dtcg": "tsx scripts/dtcg.ts",
    "consumption": "tsx scripts/consumption.ts",
    "hydrated": "tsx scripts/hydrated.ts",
    "copy": "tsx scripts/copy.ts",
    "tailwind.base": "postcss ./postcss/base.css -o ./dist/css/base.css",
    "tailwind.reset": "postcss ./postcss/reset.css -o ./dist/css/reset.css",
    "tailwind.layer": "postcss ./postcss/layer.css -o ./dist/css/layer.css",
    "tailwind.build": "npm run tailwind.base && npm run tailwind.reset && npm run tailwind.layer && npm run tailwind.typography",
    "tailwind.typography": "postcss ./postcss/typography.css -o ./dist/css/utility-typography.css",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "files": [
    "/postcss.config.js",
    "/tailwind.config.js",
    "/dist/",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magma-design-system/magma.git",
    "directory": "projects/styles"
  },
  "keywords": [
    "scss",
    "css",
    "tailwindcss"
  ],
  "author": "Vittorio Vittori",
  "contributors": [
    {
      "name": "Vittorio Vittori",
      "email": "vittorio.vittori@maggioli.it",
      "role": "UX UI Designer"
    },
    {
      "name": "Daniele Tardia",
      "email": "daniele.tardia@hibo.it",
      "role": "Senior Developer"
    },
    {
      "name": "Nicola Tamburini",
      "email": "nicola.tamburini@maggioli.it",
      "role": "Software Engineer"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "@fontsource/karla": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@maggioli-design-system/design-tokens": "^15.2.1",
    "normalize.css": "8.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "autoprefixer": "10.6.1",
    "handlebars": "4.7.10",
    "postcss-cli": "11.0.1",
    "postcss": "8.5.31",
    "postcss-import": "16.2.0",
    "tailwindcss": "4.3.3"
  }
}
