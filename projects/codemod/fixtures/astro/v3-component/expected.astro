---
// the frontmatter is TypeScript: read as text, neither rewritten nor reported
const { tone = 'raised' } = Astro.props;
const deep = items.length < limit ? 'rgb(var(--magma-accent))' : '';
---

<section class="p-400 bg-[var(--magma-surface-raised)]" style={{ color: tone }}>
  <slot />
</section>

<style lang="scss">
  section {
    border-color: color-mix(in srgb, var(--tone-neutral-09) 50%, transparent);

    &:hover {
      color: var(--magma-accent);
    }
  }
</style>

<style>
  :global(.halo) { box-shadow: 0 0 0 2px color-mix(in srgb, var(--magma-shadow-ink) 10%, transparent); }
</style>
