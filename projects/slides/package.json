{
  "name": "@maggioli-design-system/slides",
  "version": "0.0.0",
  "description": "Generate on-brand presentation decks from Markdown + frontmatter, built on Magma design tokens and styles.",
  "author": "Vittorio Vittori",
  "contributors": [
    {
      "name": "Vittorio Vittori",
      "email": "vittorio.vittori@maggioli.it",
      "role": "UX UI Designer"
    }
  ],
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "magma-slides": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build-css && tsx scripts/copy-assets.ts",
    "build-css": "postcss src/theme/slides.src.css -o dist/theme/slides.css",
    "build-examples": "npm run build && tsx scripts/build-examples.ts",
    "dev": "tsx scripts/dev.ts",
    "cli": "node dist/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "arg": "^5.0.2",
    "chalk": "^5.4.1",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.0",
    "puppeteer": "24.1.0"
  },
  "peerDependencies": {
    "@maggioli-design-system/styles": ">=16.0.0",
    "@tailwindcss/postcss": ">=4",
    "postcss": ">=8",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": { "optional": true },
    "postcss": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@maggioli-design-system/styles": "*",
    "@tailwindcss/postcss": "4.3.0",
    "postcss": "8.5.8",
    "postcss-cli": "11.0.1",
    "tailwindcss": "4.3.0",
    "vite": "*",
    "vitest": "3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magma-design-system/magma.git",
    "directory": "projects/slides"
  },
  "keywords": [
    "slides",
    "presentation",
    "markdown",
    "frontmatter",
    "design-system",
    "magma",
    "deck"
  ]
}
