/*
@magma-design-system/design-tokens v{{ version }}
Generated by Style Dictionary
Do not edit directly
Generated at {{ date }}
*/

@theme {
{{!-- font family --}}
{{#each properties as | fonts |}}
  {{#each fonts as | groups |}}
    {{#if groups.fontFamily.value }}
  --font-{{@key}}: {{#each groups.fontFamily.value}} {{ safeString this }}{{#unless @last}},{{/unless}}{{/each}};
    {{/if}}
  {{/each}}
{{/each}}

{{!-- fontsize --}}
{{#each properties as | fonts |}}
  {{#each fonts as | groups |}}
    {{#each groups.variants as | variants |}}
  --text-size-{{@../key}}-{{@key}}: {{#tailwindFontSize 'fontSize' variants.fontSize.value}}{{/tailwindFontSize}};
      {{#each variants as | rules |}}
        {{#ifTailwindFontSizeProp @key}}
  --text-size-{{@../../key}}-{{@../key}}--{{#kebabCase}}{{@key}}{{/kebabCase}}: {{#tailwindFontSize @key rules.value}}{{/tailwindFontSize}};
        {{/ifTailwindFontSizeProp}}
      {{/each}}
    {{/each}}
  {{/each}}
{{/each}}

{{!-- titles by role (#1189): text-size-title-page, read by the text-title-<role> utilities. The
  literal of the level is the fallback, as for the rhythm bridges: a sheet that references this
  theme (the components, @reference) gets the value as Tailwind writes it, var(--role, value),
  and without it a page with no token sheet would fall back to the inherited size --}}
{{#each properties.role.title as | title role |}}
  {{#with (lookup @root.properties.typography.title.variants title.value) as | level |}}
  --text-size-title-{{role}}: var(--text-size-title-{{title.value}}, {{#tailwindFontSize 'fontSize' level.fontSize.value}}{{/tailwindFontSize}});
    {{#each level as | rules prop |}}
      {{#ifTailwindFontSizeProp prop}}
  --text-size-title-{{role}}--{{#kebabCase}}{{prop}}{{/kebabCase}}: var(--text-size-title-{{title.value}}--{{#kebabCase}}{{prop}}{{/kebabCase}}, {{#tailwindFontSize prop rules.value}}{{/tailwindFontSize}});
      {{/ifTailwindFontSizeProp}}
    {{/each}}
  {{/with}}
{{/each}}

{{!-- leading --}}
{{#each properties as | property |}}
  {{#each property.leading as | leading |}}
  --leading-{{@key}}: {{#pixelToRem}}{{leading.value}}{{/pixelToRem}};
  {{/each}}
{{/each}}

{{!-- spacing --}}
  --spacing: {{properties.spacing-scale.value}};
{{#each properties.spacing as | spacing |}}
  --spacing-{{@key}}: {{spacing.value}};
{{/each}}

{{!-- container with --}}
{{#each properties.container as | container |}}
  --container-{{@key}}: {{container.value}};
{{/each}}

{{!-- the bridges of the design language (#1189): a relation of the rhythm is a spacing key
  (gap-between-fields, p-inset), the column of a form a container key (max-w-form). The roles
  are declared by typography.css; the literal is the fallback, which editors show --}}
{{#each properties.role.rhythm as | step |}}
  --spacing-{{@key}}: var(--magma-rhythm-{{@key}}, {{step.value}});
{{/each}}
  --container-form: var(--magma-width-form, {{properties.role.width.reading.value}});

{{!-- the bridge of --magma-container-actions, the threshold of a row of actions
  (actions/stacked): a container size, so Tailwind makes @actions: and @max-actions: from it, and
  its literal, not a var() of the role, since a container query reads no var(); the sheets of the
  components read it at build time with --theme(--container-actions) --}}
{{#each properties.role.container as | size |}}
  --container-{{@key}}: {{size.value}};
{{/each}}

{{!-- size utilities: w-*, min-w-*, max-w-* and basis-* read their own namespace, then
  spacing, then container. A key spacing and container share (2xl) is a container size:
  point the own namespace at it, or the spacing step wins (max-w-2xl would be 48px).
  max-w-none is none, not spacing's 0px (#1057) --}}
{{#each (sharedKeys properties.spacing properties.container) as | key |}}
  --width-{{key}}: var(--container-{{key}});
  --min-width-{{key}}: var(--container-{{key}});
  --max-width-{{key}}: var(--container-{{key}});
  --flex-basis-{{key}}: var(--container-{{key}});
{{/each}}
  --max-width-none: none;

{{!-- screens breakpoint --}}
{{#each properties.screen as | screen |}}
  --breakpoint-{{@key}}: {{screen.min.value}};
{{/each}}

{{!-- aspet ration --}}
{{#each properties.sizing.aspectRatio as | ratio |}}
  --aspect-{{@key}}: {{ratio.value}};
{{/each}}

{{!-- timing function --}}
{{#each properties.css.timingFunction as | timing |}}
  --ease-{{@key}}: {{timing.value}};
{{/each}}

{{!-- duration --}}
{{#each properties.css.duration as | duration |}}
  --duration-{{@key}}: {{duration.value}};
{{/each}}

{{!-- border --}}
{{#each properties.cosmetic.border as | border |}}
  {{#ifTailwind4Border @key}}
  --border-{{@key}}: {{border.value}};
  {{/ifTailwind4Border}}
{{/each}}

{{!-- radius --}}
{{#each properties.radius as | radius |}}
  {{#ifTailwind4Border @key}}
  --radius-{{@key}}: {{radius.value}};
  {{/ifTailwind4Border}}
{{/each}}

{{!-- box shadow --}}
{{#each properties.cosmetic.boxShadow as | shadow |}}
  --shadow-{{@key}}: {{shadow.value}};
{{/each}}
}

{{!-- utilities --}}
{{!-- transition property --}}
{{#each properties.css.transitionProperty as | transition |}}
@utility transition-{{@key}} {
  transition-property: {{transition.value}};
  transition-timing-function: var(--default-transition-timing-function); /* default cubic-bezier(0.4, 0, 0.2, 1) */
  transition-duration: var(--default-transition-duration); /* default 150ms */
}
{{/each}}

{{!-- grid template columns --}}
{{#each properties.css.gridTemplateColumns as | grid |}}
@utility grid-cols-{{@key}} {
  grid-template-columns: {{grid.value}};
}
{{/each}}
