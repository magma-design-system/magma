{
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "lib": ["esnext"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "resolveJsonModule": true,
    "sourceMap": false,
    "strict": false,
    "target": "ESNext",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "test" ]
}
