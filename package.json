{
  "name": "maggioli-design-system",
  "version": "1.0.0",
  "description": "Maggioli Design System è uno strumento nato per condividere una unica visione di progettazione condivisa tra tutti gli esperti di dominio aziendali. Ciò permette di offrire una UX unica, condivisa tra i prodotti che saranno coerenti allo stile dell’azienda.",
  "private": true,
  "nx": {
    "includedScripts": []
  },
  "workspaces": [
    "projects/*"
  ],
  "overrides": {
    "caniuse-lite": "1.0.30001817",
    "minimatch@^9.0.0": "9.0.9",
    "picomatch@^4.0.0": "4.0.7",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@commitlint/rules": "19.8.1",
    "@eslint/compat": "1.4.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.9.9",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/browser-playwright": "4.1.12",
    "chalk": "4.1.2",
    "eslint": "9.39.5",
    "fs-extra": "11.4.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "nx": "23.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stylelint": "16.26.1",
    "stylelint-config-recess-order": "7.8.1",
    "stylelint-config-standard": "38.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "stylelint-order": "7.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "clean-modules": "find . -type d -name node_modules -prune -exec rm -rf {} + && find . -type f -name package-lock.json -delete",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,css}' '!**/deprecated/**'",
    "format:check": "prettier --check '**/*.{js,jsx,ts,tsx,css}' '!**/deprecated/**'",
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "projects/stencil/src/**/*.{js,jsx,ts,tsx}": [
      "eslint --config projects/stencil/eslint.config.mjs --fix"
    ],
    "projects/{design-tokens,styles,icons,svg-icons,identity}/src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magma-design-system/magma.git"
  },
  "author": {
    "name": "Vittorio Vittori",
    "email": "vittorio.vittori@maggioli.it",
    "url": "https://vitto.github.io/vit.to/"
  },
